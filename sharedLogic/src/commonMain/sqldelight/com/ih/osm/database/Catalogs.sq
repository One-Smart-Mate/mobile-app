CREATE TABLE CardTypeCatalog (
    site_id INTEGER NOT NULL,
    id TEXT NOT NULL,
    methodology TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    color TEXT NOT NULL,
    owner TEXT,
    status TEXT NOT NULL,
    quantity_images_create INTEGER,
    quantity_audios_create INTEGER,
    quantity_videos_create INTEGER,
    audios_duration_create INTEGER,
    videos_duration_create INTEGER,
    quantity_images_close INTEGER,
    quantity_audios_close INTEGER,
    quantity_videos_close INTEGER,
    audios_duration_close INTEGER,
    videos_duration_close INTEGER,
    quantity_images_ps INTEGER,
    quantity_audios_ps INTEGER,
    quantity_videos_ps INTEGER,
    audios_duration_ps INTEGER,
    videos_duration_ps INTEGER,
    card_type_methodology TEXT,
    PRIMARY KEY (site_id, id)
);

CREATE TABLE PreclassifierCatalog (
    site_id INTEGER NOT NULL,
    id TEXT NOT NULL,
    code TEXT NOT NULL,
    description TEXT NOT NULL,
    card_type_id TEXT NOT NULL,
    PRIMARY KEY (site_id, id)
);

CREATE TABLE PriorityCatalog (
    site_id INTEGER NOT NULL,
    id TEXT NOT NULL,
    code TEXT NOT NULL,
    description TEXT NOT NULL,
    days INTEGER NOT NULL,
    status TEXT NOT NULL,
    PRIMARY KEY (site_id, id)
);

CREATE TABLE LevelCatalog (
    site_id INTEGER NOT NULL,
    id TEXT NOT NULL,
    owner_id TEXT,
    owner_name TEXT,
    superior_id TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    status TEXT NOT NULL,
    PRIMARY KEY (site_id, id)
);

CREATE TABLE EmployeeCatalog (
    site_id INTEGER NOT NULL,
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    email TEXT NOT NULL,
    PRIMARY KEY (site_id, id)
);

CREATE TABLE CatalogSyncMetadata (
    user_id INTEGER NOT NULL PRIMARY KEY,
    site_scope TEXT NOT NULL,
    completed_at_epoch_ms INTEGER NOT NULL
);

selectCardTypesBySite:
SELECT * FROM CardTypeCatalog WHERE site_id = ? ORDER BY name;

hasCardTypesBySite:
SELECT EXISTS(SELECT 1 FROM CardTypeCatalog WHERE site_id = ? LIMIT 1);

selectPreclassifiersBySite:
SELECT * FROM PreclassifierCatalog WHERE site_id = ? ORDER BY code;

hasPreclassifiersBySite:
SELECT EXISTS(SELECT 1 FROM PreclassifierCatalog WHERE site_id = ? LIMIT 1);

selectPrioritiesBySite:
SELECT * FROM PriorityCatalog WHERE site_id = ? ORDER BY days, code;

hasPrioritiesBySite:
SELECT EXISTS(SELECT 1 FROM PriorityCatalog WHERE site_id = ? LIMIT 1);

selectLevelsBySite:
SELECT * FROM LevelCatalog WHERE site_id = ? ORDER BY name;

hasLevelsBySite:
SELECT EXISTS(SELECT 1 FROM LevelCatalog WHERE site_id = ? LIMIT 1);

selectEmployeesBySite:
SELECT * FROM EmployeeCatalog WHERE site_id = ? ORDER BY name;

hasEmployeesBySite:
SELECT EXISTS(SELECT 1 FROM EmployeeCatalog WHERE site_id = ? LIMIT 1);

selectCatalogSyncMetadata:
SELECT * FROM CatalogSyncMetadata WHERE user_id = ?;

deleteCatalogSyncMetadata:
DELETE FROM CatalogSyncMetadata WHERE user_id = ?;

deleteAllCatalogSyncMetadata:
DELETE FROM CatalogSyncMetadata;

deleteCardTypesBySite:
DELETE FROM CardTypeCatalog WHERE site_id = ?;

deleteAllCardTypes:
DELETE FROM CardTypeCatalog;

deletePreclassifiersBySite:
DELETE FROM PreclassifierCatalog WHERE site_id = ?;

deleteAllPreclassifiers:
DELETE FROM PreclassifierCatalog;

deletePrioritiesBySite:
DELETE FROM PriorityCatalog WHERE site_id = ?;

deleteAllPriorities:
DELETE FROM PriorityCatalog;

deleteLevelsBySite:
DELETE FROM LevelCatalog WHERE site_id = ?;

deleteAllLevels:
DELETE FROM LevelCatalog;

deleteEmployeesBySite:
DELETE FROM EmployeeCatalog WHERE site_id = ?;

deleteAllEmployees:
DELETE FROM EmployeeCatalog;

insertCardType:
INSERT OR REPLACE INTO CardTypeCatalog VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertPreclassifier:
INSERT OR REPLACE INTO PreclassifierCatalog VALUES (?, ?, ?, ?, ?);

insertPriority:
INSERT OR REPLACE INTO PriorityCatalog VALUES (?, ?, ?, ?, ?, ?);

insertLevel:
INSERT OR REPLACE INTO LevelCatalog VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertEmployee:
INSERT OR REPLACE INTO EmployeeCatalog VALUES (?, ?, ?, ?);

upsertCatalogSyncMetadata:
INSERT OR REPLACE INTO CatalogSyncMetadata(user_id, site_scope, completed_at_epoch_ms) VALUES (?, ?, ?);
